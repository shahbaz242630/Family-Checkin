DATABASE_URL="postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres"
KMS_MASTER_KEY_BASE64="replace-with-32-byte-base64-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
# Optional and UNUSED. The backend never calls the Supabase admin API: authorisation is RLS plus the backend's own
# database connection (founder decision 2026-09-06, CB-025). Leave it unset; an old value is accepted and ignored.
# SUPABASE_SERVICE_ROLE_KEY=""
OPERATIONS_CRON_SECRET="replace-with-random-operations-cron-secret"
# Public HTTPS origin of this API, no trailing slash. Twilio signs every webhook over this origin plus the route
# path, and StatusCallback URLs are only sent when it is set (docs/providers/twilio.md).
PUBLIC_API_BASE_URL="https://api.example.com"
PORT="3000"

# Channel providers
# Use "fake" for local full-journey testing without provider credentials (nothing leaves the machine).
# Use "configured" when real Twilio credentials are available. Twilio is the only provider for SMS, WhatsApp and
# voice; every TWILIO_* value is optional at boot and a missing one fails at first use of that channel.
CHANNEL_PROVIDER_MODE="fake"

# Twilio: account, messaging, WhatsApp (Twilio route only; the Meta Cloud API path was deleted 2026-09-06), voice
# and webhook signature validation. Console setup: docs/providers/twilio.md; templates: docs/providers/whatsapp.md.
TWILIO_ACCOUNT_SID="replace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_SMS_FROM_NUMBER="+15550001111"
TWILIO_WHATSAPP_FROM_NUMBER="+15550002222"
# JSON object: "templateKey:language" (or "templateKey" as the fallback for every language) -> approved Content SID
# (HX...). Parsed at boot; malformed JSON fails boot. Keys are the channel_templates template keys.
TWILIO_WHATSAPP_CONTENT_SIDS="{\"consent_request:en\":\"HX_REPLACE_CONSENT_EN\",\"checkin_daily:en\":\"HX_REPLACE_CHECKIN_EN\"}"
TWILIO_VOICE_FROM_NUMBER="+15550003333"
# Where the recorded voice prompts live: ${VOICE_AUDIO_BASE_URL}/{en|ar|es|hi|ur|ml|ta|bn}/{scriptKey}.wav.
# Verify with `npm run providers:check-voice-audio` (docs/providers/twilio.md).
VOICE_AUDIO_BASE_URL="https://cdn.example.com/voice"

# RevenueCat subscriptions
REVENUECAT_WEBHOOK_AUTH_TOKEN="replace-with-random-revenuecat-webhook-auth-token"
REVENUECAT_ENTITLEMENT_ID="nearby_access"

# HTTP hardening
# Global rate limit: RATE_LIMIT_MAX_REQUESTS requests per RATE_LIMIT_TTL_SECONDS per client IP.
# Provider webhooks and the operations cron endpoints are exempt (signature/secret authenticated,
# called by machines in bursts). Both values must be positive integers.
# RATE_LIMIT_TTL_SECONDS="60"
# RATE_LIMIT_MAX_REQUESTS="300"

# Must be set when the backend runs behind a load balancer or reverse proxy so the real client
# IP is read from X-Forwarded-For; otherwise every client shares the proxy's IP for rate limiting.
# Passed to Express "trust proxy": a hop count (1), true, loopback/linklocal/uniquelocal, or a CIDR.
# TRUST_PROXY="1"

# Comma-separated exact browser origins allowed by CORS, in addition to http://localhost:80xx and
# http://127.0.0.1:80xx. Requests without an Origin header (the native app) are always allowed.
# CORS_ALLOWED_ORIGINS="https://admin.example.com,https://app.example.com"

# Supabase access-token verification (CB-024). Tokens are verified locally; no request goes to Supabase
# per API call. Leave this unset when the project signs tokens with asymmetric keys (Supabase dashboard:
# Project Settings -> JWT Keys, "current key" is ECC or RSA): the backend fetches and caches
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json. Set it only for a project still on the
# legacy HS256 shared secret (Project Settings -> JWT Keys -> Legacy JWT Secret).
# SUPABASE_JWT_SECRET="replace-with-supabase-legacy-jwt-secret"

# Expo push (optional). An Expo access token (expo.dev > Access tokens) is sent as a bearer to the push API so
# sends are attributed to the project and enhanced push security can be turned on. Unset = unauthenticated sends.
# EXPO_ACCESS_TOKEN=""
