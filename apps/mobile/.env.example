EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Local backend examples:
# iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: http://YOUR_LAN_IP:3000
EXPO_PUBLIC_BACKEND_URL="http://localhost:3000"

# RevenueCat public SDK keys. Required in development/prod builds for real purchases.
# RevenueCat native SDKs require a development/TestFlight/Play build; Expo Go is not enough.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=""
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID="nearby_access"
